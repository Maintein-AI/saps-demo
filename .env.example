# ── Access gate credentials ───────────────────────────────────────────────
# The site is protected by a server-side login (see middleware.ts). Set these
# in production via Vercel → Project → Settings → Environment Variables.
# For local development, copy this file to ".env.local" and edit the values.

# Username required to sign in.
GATE_USERNAME=

# Password required to sign in. CHANGE THIS before deploying.
GATE_PASSWORD=

# Secret stored in the auth cookie. Use a long random string and keep it private.
# Changing it instantly logs everyone out. CHANGE THIS before deploying.
GATE_SECRET=replace-with-a-long-random-secret-string
